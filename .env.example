# Local development. On the server, Ansible renders this file from the vault.
DATABASE_URL=postgres://postgres:dev@localhost:5433/mealplanner?sslmode=disable
SESSION_SECRET=change-me-to-32-or-more-random-characters
BASE_URL=http://localhost:8080
ADMIN_EMAIL=you@example.com
# Leave empty to run without plan generation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Email via Resend. Leave empty to only log that an email would be sent.
RESEND_API_KEY=
EMAIL_FROM=Meal Planner <meals@liluhome.dk>
