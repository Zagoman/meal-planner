diff --git a/mealplanner/backup.sh b/mealplanner/backup.sh
new file mode 100755
index 0000000..5773bbf
--- /dev/null
+++ b/mealplanner/backup.sh
@@ -0,0 +1,51 @@
+#!/bin/sh
+# pg_dump loop for the mealplanner stack. Runs in a postgres:17 container
+# with PGHOST/PGUSER/PGPASSWORD/PGDATABASE set (see compose.yml).
+#
+#   sh /backup.sh        dump now if none in the last 24 h, then daily at BACKUP_AT
+#   sh /backup.sh now    one dump, then exit
+#
+# Dumps are custom format (pg_dump -Fc): restore with pg_restore (deploy/README.md).
+set -u
+
+dir=/backups
+at=${BACKUP_AT:-03:00}
+keep=${BACKUP_KEEP_DAYS:-14}
+
+log() { echo "$(date -Iseconds) backup: $*"; }
+
+dump() {
+	ts=$(date +%Y%m%d-%H%M%S)
+	tmp="$dir/.mealplanner-$ts.dump.partial"
+	if pg_dump --format=custom --file="$tmp"; then
+		mv "$tmp" "$dir/mealplanner-$ts.dump"
+		log "wrote mealplanner-$ts.dump ($(du -h "$dir/mealplanner-$ts.dump" | cut -f1))"
+	else
+		rm -f "$tmp"
+		log "FAILED: pg_dump exited non-zero"
+		return 1
+	fi
+	# Keep $keep days: delete dumps older than that.
+	find "$dir" -maxdepth 1 -name 'mealplanner-*.dump' -mtime +"$((keep - 1))" -print -delete |
+		sed 's/^/pruned /'
+}
+
+if [ "${1:-}" = now ]; then
+	dump
+	exit $?
+fi
+
+if [ -z "$(find "$dir" -maxdepth 1 -name 'mealplanner-*.dump' -mmin -1440)" ]; then
+	log "no dump in the last 24 h, dumping in 60 s (after the app's migrations)"
+	sleep 60
+	dump || true
+fi
+
+while :; do
+	now=$(date +%s)
+	next=$(date -d "today $at" +%s)
+	[ "$next" -le "$now" ] && next=$(date -d "tomorrow $at" +%s)
+	log "next dump at $(date -d "@$next" -Iseconds)"
+	sleep "$((next - now))"
+	dump || true
+done
diff --git a/mealplanner/compose.yml b/mealplanner/compose.yml
new file mode 100644
index 0000000..c00ba1e
--- /dev/null
+++ b/mealplanner/compose.yml
@@ -0,0 +1,89 @@
+# Meal planner stack for the homelab (/opt/stacks/mealplanner on the server).
+# Canonical copy: Zagoman/meal-planner deploy/stack/. The homelab repo carries
+# an identical copy (deploy/homelab/ has the patch); `make deploy` warns when
+# the server's copy drifts from this one.
+#
+# .env is rendered by Ansible (stack_env.mealplanner): APPDATA_DIR,
+# POSTGRES_PASSWORD, DATABASE_URL, SESSION_SECRET, BASE_URL, ADMIN_EMAIL,
+# ANTHROPIC_API_KEY, CLAUDE_MODEL, TZ.
+name: mealplanner
+
+services:
+  app:
+    image: ghcr.io/zagoman/meal-planner:${MEALPLANNER_TAG:-latest}
+    container_name: mealplanner
+    restart: unless-stopped
+    depends_on:
+      db:
+        condition: service_healthy
+    environment:
+      ADDR: ":8080"
+      DATABASE_URL: ${DATABASE_URL:?DATABASE_URL is required}
+      SESSION_SECRET: ${SESSION_SECRET:?SESSION_SECRET is required}
+      BASE_URL: ${BASE_URL:-https://meals.liluhome.dk}
+      ADMIN_EMAIL: ${ADMIN_EMAIL:-}
+      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
+      CLAUDE_MODEL: ${CLAUDE_MODEL:-claude-sonnet-5-5}
+      TZ: ${TZ:-Europe/Copenhagen}
+    healthcheck:
+      # distroless: no shell or curl, the binary checks itself.
+      test: ["CMD", "/server", "healthcheck"]
+      interval: 30s
+      timeout: 5s
+      retries: 3
+      start_period: 60s
+    # No published ports: Caddy reaches it as mealplanner:8080 on `proxy`.
+    networks:
+      - default
+      - proxy
+
+  db:
+    image: postgres:17
+    container_name: mealplanner-db
+    restart: unless-stopped
+    environment:
+      POSTGRES_DB: mealplanner
+      POSTGRES_USER: mealplanner
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required}
+      TZ: ${TZ:-Europe/Copenhagen}
+    volumes:
+      - ${APPDATA_DIR:?APPDATA_DIR is required}/mealplanner/db:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U mealplanner -d mealplanner"]
+      interval: 10s
+      timeout: 5s
+      retries: 5
+      start_period: 30s
+    networks:
+      - default
+
+  # Nightly pg_dump at 03:00 (before restic's 03:30 run) into
+  # ${APPDATA_DIR}/mealplanner/backups, keeping 14 days. Manual dump:
+  #   docker compose exec backup sh /backup.sh now
+  backup:
+    image: postgres:17
+    container_name: mealplanner-backup
+    restart: unless-stopped
+    user: "999:999" # postgres uid in the image; owns the backups dir
+    init: true # forward SIGTERM to the sleeping loop
+    depends_on:
+      db:
+        condition: service_healthy
+    entrypoint: ["sh", "/backup.sh"]
+    environment:
+      PGHOST: db
+      PGUSER: mealplanner
+      PGDATABASE: mealplanner
+      PGPASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required}
+      BACKUP_AT: "03:00"
+      BACKUP_KEEP_DAYS: "14"
+      TZ: ${TZ:-Europe/Copenhagen}
+    volumes:
+      - ./backup.sh:/backup.sh:ro
+      - ${APPDATA_DIR:?APPDATA_DIR is required}/mealplanner/backups:/backups
+    networks:
+      - default
+
+networks:
+  proxy:
+    external: true
diff --git a/mealplanner/restore.sh b/mealplanner/restore.sh
new file mode 100755
index 0000000..15686fb
--- /dev/null
+++ b/mealplanner/restore.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Restore the mealplanner database from a pg_dump file made by backup.sh.
+# Run on the server from the stack folder:
+#   ./restore.sh /srv/appdata/mealplanner/backups/mealplanner-YYYYMMDD-HHMMSS.dump
+# Takes a fresh safety dump first, then REPLACES the current database.
+# Set RESTORE_YES=1 to skip the prompt.
+set -euo pipefail
+
+dump=${1:?usage: restore.sh <file.dump>}
+[[ -r "$dump" ]] || { echo "restore: cannot read $dump" >&2; exit 1; }
+cd "$(dirname "${BASH_SOURCE[0]}")"
+
+if [[ "${RESTORE_YES:-}" != 1 ]]; then
+	read -r -p "Replace the mealplanner database with $(basename "$dump")? Type yes: " ans
+	[[ "$ans" == yes ]] || { echo "aborted"; exit 1; }
+fi
+
+echo "==> safety dump of the current database"
+docker compose exec -T backup sh /backup.sh now
+
+echo "==> stopping app"
+docker compose stop app
+
+echo "==> recreating database"
+docker compose exec -T db dropdb -U mealplanner --force --if-exists mealplanner
+docker compose exec -T db createdb -U mealplanner -O mealplanner mealplanner
+
+echo "==> restoring $dump"
+docker compose exec -T db pg_restore -U mealplanner -d mealplanner --no-owner --exit-on-error <"$dump"
+
+echo "==> starting app"
+docker compose start app
+echo "restored; check: docker exec mealplanner /server healthcheck && echo ok"
