package web

// Tab is one of the screens in the bottom navigation.
type Tab string

const (
	TabNone      Tab = "" // signed-out pages: no navigation
	TabList      Tab = "list"
	TabWeek      Tab = "week"
	TabRecipe    Tab = "recipe"
	TabRecipes   Tab = "recipes"
	TabProfile   Tab = "profile"
	TabHousehold Tab = "household" // inside Profile
)

type navItem struct {
	tab   Tab
	href  string
	label string
	icon  string // SVG path data, 24x24, stroked
}

var nav = []navItem{
	{TabList, "/list", "List", "M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"},
	{TabWeek, "/week", "Week", "M4 6h16v14H4zM4 10h16M8 3v4M16 3v4"},
	{TabRecipes, "/recipes", "Recipes", "M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11"},
	{TabProfile, "/profile", "Profile", "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 20a8 8 0 0 1 16 0"},
}

// tabActive reports whether a nav tab is highlighted for the current page.
func tabActive(n navItem, active Tab) bool {
	return n.tab == active || (n.tab == TabWeek && active == TabRecipe) || (n.tab == TabProfile && active == TabHousehold)
}

// htmxConfig swaps error responses too: handlers retarget them to #flash.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}],"scrollIntoViewOnBoost":false}`

// Layout is the base page: htmx + SSE extension, PWA manifest, service
// worker, bottom navigation. Pages render their content as children.
templ Layout(title string, active Tab) {
	@page(title, active, "", "", active != TabNone) {
		{ children... }
	}
}

// FullLayout is a full-screen flow (review, rating, cook mode, ...): no tab
// bar, a back link above the title.
templ FullLayout(title, back, backLabel string) {
	@page(title, tabOther, back, backLabel, false) {
		{ children... }
	}
}

templ page(title string, active Tab, back, backLabel string, showNav bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#2f6f4f"/>
			<meta name="referrer" content="same-origin"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title } · Meal Planner</title>
			<link rel="manifest" href="/static/manifest.webmanifest"/>
			<link rel="icon" href="/static/icon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/htmx-ext-sse.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body hx-boost="true" data-signed-in?={ active != TabNone } class={ templ.KV("full", !showNav && active != TabNone) }>
			if back != "" {
				<nav class="back"><a href={ templ.SafeURL(back) }>‹ { backLabel }</a></nav>
			}
			<header class="top">
				<h1>{ title }</h1>
				<span id="offline-badge" class="badge offline" hidden>Offline</span>
			</header>
			<div id="flash" role="status" aria-live="polite"></div>
			<main id="main">
				{ children... }
			</main>
			if showNav {
				<nav class="tabs" aria-label="Main">
					for _, n := range nav {
						<a
							href={ templ.SafeURL(n.href) }
							if tabActive(n, active) {
								aria-current="page"
							}
						>
							<svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={ n.icon }></path></svg>
							{ n.label }
						</a>
					}
				</nav>
			}
		</body>
	</html>
}

// Flash is an error message swapped into #flash by htmx requests.
templ Flash(msg string, problems []string) {
	<div class="flash error">
		<p>{ msg }</p>
		if len(problems) > 0 {
			<ul>
				for _, p := range problems {
					<li>{ p }</li>
				}
			</ul>
		}
		<button type="button" class="link" data-dismiss-flash>Dismiss</button>
	</div>
}

// Notice is a success message for #flash.
templ Notice(msg string) {
	<div class="flash ok"><p>{ msg }</p></div>
}

templ ErrorPage(status int, msg string, problems []string, signedIn bool) {
	@Layout(statusTitle(status), tabIf(signedIn)) {
		@Flash(msg, problems)
		<p><a href="/list">Back to the list</a></p>
	}
}
