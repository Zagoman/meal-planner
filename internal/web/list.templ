package web

import (
	"strconv"

	"github.com/Zagoman/meal-planner/internal/domain"
)

templ ListPage(l domain.List, hasPlan bool, sections []domain.Section) {
	@Layout("Shopping list", TabList) {
		if !hasPlan {
			<div class="empty">
				<p>No plan this week yet, so there's no list.</p>
				<p><a class="button" href="/week">Plan the week</a></p>
			</div>
		} else {
			<div id="list-live" hx-ext="sse" sse-connect="/list/stream">
				<div id="list" sse-swap="list" hx-swap="innerHTML">
					@ListBody(l)
				</div>
			</div>
			@AddItemForm(sections)
		}
	}
}

// ListBody is the whole list; it is what the SSE stream sends on each
// change. Each part has a stable id (#progress, #check-home,
// #section-{key}, #item-{id}) so it can be swapped on its own.
templ ListBody(l domain.List) {
	@Progress(l)
	if len(l.CheckHome) > 0 {
		@CheckHome(l)
	}
	for _, sec := range l.Sections {
		@ListSection(sec)
	}
}

// Progress counts only the items to buy, not Check at home items.
templ Progress(l domain.List) {
	{{ done, total := l.Progress() }}
	<div id="progress" class="progress" data-done={ itoa(done) } data-total={ itoa(total) }>
		<p class="progress-text">{ itoa(done) } of { itoa(total) } in the basket</p>
		<div class="bar" role="progressbar" aria-label="Shopping progress" aria-valuemin="0" aria-valuemax={ itoa(total) } aria-valuenow={ itoa(done) }>
			<div class="bar-fill" style={ barStyle(done, total) }></div>
		</div>
	</div>
}

// CheckHome is the card of pantry items at the top: "Have it" hides an item
// from the shopping, "Buy" adds it to its section below.
templ CheckHome(l domain.List) {
	<section id="check-home" class="check-home">
		<h2 class="sec-label">Check at home · { itoa(l.CheckHomeAnswered()) } of { itoa(len(l.CheckHome)) } checked</h2>
		<div class="card home-card">
			<p class="small">Before you leave, mark what's already in the house. Anything marked Buy joins the list below.</p>
			<ul class="items">
				for _, it := range l.CheckHome {
					@HomeItem(it)
				}
			</ul>
		</div>
	</section>
}

templ HomeItem(it domain.ListItem) {
	<li id={ "home-" + it.ID.String() } class="home-row">
		<span class="name">{ it.Name }</span>
		<div class="seg" role="group" aria-label={ it.Name }>
			@haveItButton(it, true, "Have it")
			@haveItButton(it, false, "Buy")
		</div>
	</li>
}

// haveItButton posts the answer; tapping the selected answer again clears it.
templ haveItButton(it domain.ListItem, value bool, label string) {
	{{ on := it.HaveIt != nil && *it.HaveIt == value }}
	<form class="seg-form" method="post" action={ templ.SafeURL("/list/items/" + it.ID.String() + "/home") }
		hx-post={ "/list/items/" + it.ID.String() + "/home" }
		hx-target="#list"
		hx-swap="innerHTML"
	>
		if on {
			<input type="hidden" name="have_it" value=""/>
		} else {
			<input type="hidden" name="have_it" value={ strconv.FormatBool(value) }/>
		}
		<button type="submit" class={ "sb", templ.KV("sb-on", on) } aria-pressed={ strconv.FormatBool(on) }>{ label }</button>
	</form>
}

templ ListSection(sec domain.ListSection) {
	<section class="sec" id={ "section-" + sec.Key }>
		<h2 class="sec-label">{ sec.Name }</h2>
		<ul class="items card">
			for _, it := range sec.Items {
				@Item(it)
			}
		</ul>
	</section>
}

// Item is one row; ticking swaps just this element.
templ Item(it domain.ListItem) {
	<li id={ "item-" + it.ID.String() } class={ "item", templ.KV("checked", it.Checked) }>
		<button
			type="button"
			class="tick"
			hx-post={ "/list/items/" + it.ID.String() + "/toggle" }
			hx-vals={ checkVals(it) }
			hx-target="closest li"
			hx-swap="outerHTML"
			data-item-id={ it.ID.String() }
			data-checked={ strconv.FormatBool(it.Checked) }
			aria-pressed={ strconv.FormatBool(it.Checked) }
		>
			<span class="box" aria-hidden="true"></span>
			<span class="name">{ it.Name }</span>
			if qty := qtyLine(it); qty != "" {
				<span class="need">{ qty }</span>
			}
		</button>
		if it.IsManual {
			<button
				type="button"
				class="del"
				hx-post={ "/list/items/" + it.ID.String() + "/delete" }
				hx-target="closest li"
				hx-swap="outerHTML"
				aria-label={ "Remove " + it.Name }
			>×</button>
		}
	</li>
}

templ AddItemForm(sections []domain.Section) {
	<form
		class="add add-item"
		action="/list/items"
		method="post"
		hx-post="/list/items"
		hx-target="#list"
		hx-swap="innerHTML"
		hx-on::after-request="if (event.detail.successful) { this.reset(); this.querySelector('input').focus() }"
	>
		<label class="visually-hidden" for="add-name">Item</label>
		<input id="add-name" name="name" required maxlength="100" placeholder="Add an item" autocomplete="off"/>
		<label class="visually-hidden" for="add-section">Section</label>
		<select id="add-section" name="section">
			for _, s := range sections {
				<option value={ s.Key } selected?={ s.Key == "other" }>{ s.Name }</option>
			}
		</select>
		<button type="submit" class="primary">Add</button>
	</form>
}
