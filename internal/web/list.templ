package web

import (
	"strconv"

	"github.com/Zagoman/meal-planner/internal/domain"
)

templ ListPage(l domain.List, hasPlan bool, sections []domain.Section) {
	@Layout("Shopping list", TabList) {
		if !hasPlan {
			<div class="empty">
				<p class="body muted">Nothing to buy yet. Confirm a plan and the list fills itself.</p>
				<p><a class="button secondary-btn" href="/week">Go to the plan</a></p>
			</div>
		} else {
			<div id="list-live" hx-ext="sse" sse-connect="/list/stream">
				<div id="list" sse-swap="list" hx-swap="innerHTML">
					@ListBody(l, sections)
				</div>
			</div>
			<button type="button" id="add-jump" class="icon-btn add-jump" aria-label="Add an item" hidden>
				@icon("M12 5v14 M5 12h14")
			</button>
		}
	}
}

// ListBody is the whole list; it is what the SSE stream sends on each
// change. Each part has a stable id (#progress, #add-item, #check-home,
// #section-{key}, #item-{id}) so it can be swapped on its own. The add form
// sits under the progress (#4) and is kept as it is across swaps
// (hx-preserve), so a live update never wipes what someone is typing.
templ ListBody(l domain.List, sections []domain.Section) {
	@Progress(l, false)
	@AddItemForm(sections)
	if len(l.CheckHome) > 0 {
		@CheckHome(l)
	}
	for _, sec := range l.Sections {
		@ListSection(sec)
	}
}

// Progress counts only the items to buy, not Check at home items. Once
// something is in the basket it offers to clear the ticked items (#6); when
// everything is, that becomes the screen's one primary "Done shopping".
templ Progress(l domain.List, oob bool) {
	{{ done, total := l.Progress() }}
	<div
		id="progress"
		class="progress"
		data-done={ itoa(done) }
		data-total={ itoa(total) }
		if oob {
			hx-swap-oob="true"
		}
	>
		<div class="progress-row">
			if total == 0 {
				<p class="progress-text">Nothing left to buy.</p>
			} else if done == total {
				<p class="progress-text list-done">All ticked. Go home, nobody's checking.</p>
			} else {
				<p class="progress-text">{ itoa(done) } of { itoa(total) } in the basket</p>
			}
			if done > 0 && done < total {
				@clearForm("link") {
					Clear { itoa(done) } ticked
				}
			}
		</div>
		<div class="bar" role="progressbar" aria-label="Shopping progress" aria-valuemin="0" aria-valuemax={ itoa(total) } aria-valuenow={ itoa(done) }>
			<div class="bar-fill" style={ barStyle(done, total) }></div>
		</div>
		if total > 0 && done == total {
			@clearForm("primary wide") {
				Done shopping
			}
		}
	</div>
}

// clearForm posts /list/clear: the ticked items leave the list, with Undo.
templ clearForm(class string) {
	<form class="clear-form" action="/list/clear" method="post" hx-post="/list/clear" hx-target="#list" hx-swap="innerHTML">
		<button type="submit" class={ class }>{ children... }</button>
	</form>
}

// ClearedToast says how many items left the list, with Undo for 8 s.
templ ClearedToast(n int, batch string) {
	<div id="flash" role="status" aria-live="polite" hx-swap-oob="true">
		<div class="flash ok toast" data-autoclose="8000">
			<p>
				{ itoa(n) } { plural(n, "item", "items") } cleared ·
				<button type="button" class="link" hx-post="/list/clear/undo" hx-vals={ `{"batch":"` + batch + `"}` } hx-target="#list" hx-swap="innerHTML">Undo</button>
			</p>
		</div>
	</div>
}

// EmptyFlash clears #flash out of band (after an Undo).
templ EmptyFlash() {
	<div id="flash" role="status" aria-live="polite" hx-swap-oob="true"></div>
}

// tickSwap answers a tick: the item's section, re-sorted, and the progress.
templ tickSwap(sec domain.ListSection, l domain.List) {
	@ListSection(sec)
	@Progress(l, true)
}

// CheckHome is the card of pantry items at the top: "Have it" hides an item
// from the shopping, "Buy" adds it to its section below.
templ CheckHome(l domain.List) {
	<section id="check-home" class="check-home">
		<h2 class="sec-label">Check at home · { itoa(l.CheckHomeAnswered()) } of { itoa(len(l.CheckHome)) } checked</h2>
		<div class="card home-card">
			<p class="small">Before you leave, mark what's already in the house. Anything marked Buy joins the list below.</p>
			<ul class="items">
				for _, it := range l.CheckHome {
					@HomeItem(it)
				}
			</ul>
		</div>
	</section>
}

templ HomeItem(it domain.ListItem) {
	<li id={ "home-" + it.ID.String() } class="home-row">
		<span class="name">{ it.Name }</span>
		<div class="seg" role="group" aria-label={ it.Name }>
			@haveItButton(it, true, "Have it")
			@haveItButton(it, false, "Buy")
		</div>
	</li>
}

// haveItButton posts the answer; tapping the selected answer again clears it.
templ haveItButton(it domain.ListItem, value bool, label string) {
	{{ on := it.HaveIt != nil && *it.HaveIt == value }}
	<form class="seg-form" method="post" action={ templ.SafeURL("/list/items/" + it.ID.String() + "/home") }
		hx-post={ "/list/items/" + it.ID.String() + "/home" }
		hx-target="#list"
		hx-swap="innerHTML"
	>
		if on {
			<input type="hidden" name="have_it" value=""/>
		} else {
			<input type="hidden" name="have_it" value={ strconv.FormatBool(value) }/>
		}
		<button type="submit" class={ "sb", templ.KV("sb-on", on) } aria-pressed={ strconv.FormatBool(on) }>{ label }</button>
	</form>
}

// ListSection is one shop section: items to buy first, then the ones in the
// basket (#1). When all are in the basket it folds to "All in basket",
// which opens on a tap.
templ ListSection(sec domain.ListSection) {
	<section class={ "sec", templ.KV("sec-done", sectionDone(sec)) } id={ "section-" + sec.Key }>
		<h2 class="sec-label">{ sec.Name }</h2>
		if sectionDone(sec) {
			<details class="all-in">
				<summary>All in basket · { itoa(len(sec.Items)) }</summary>
				@sectionItems(sec)
			</details>
		} else {
			@sectionItems(sec)
		}
	</section>
}

templ sectionItems(sec domain.ListSection) {
	<ul class="items card">
		for _, it := range sec.Items {
			@Item(it)
		}
	</ul>
}

// Item is one row; ticking swaps just this element.
templ Item(it domain.ListItem) {
	<li id={ "item-" + it.ID.String() } class={ "item", templ.KV("checked", it.Checked) }>
		<button
			type="button"
			class="tick"
			hx-post={ "/list/items/" + it.ID.String() + "/toggle" }
			hx-vals={ checkVals(it) }
			hx-target="closest section"
			hx-swap="outerHTML"
			data-item-id={ it.ID.String() }
			data-name={ it.Name }
			data-checked={ strconv.FormatBool(it.Checked) }
			aria-pressed={ strconv.FormatBool(it.Checked) }
		>
			<span class="box" aria-hidden="true"></span>
			<span class="name">{ it.Name }</span>
			if qty := qtyLine(it); qty != "" {
				<span class="need">{ qty }</span>
			}
		</button>
		if it.IsManual {
			<button
				type="button"
				class="del"
				hx-post={ "/list/items/" + it.ID.String() + "/delete" }
				hx-target="closest li"
				hx-swap="outerHTML"
				aria-label={ "Remove " + it.Name }
			>×</button>
		}
	</li>
}

templ AddItemForm(sections []domain.Section) {
	<form
		id="add-item"
		hx-preserve="true"
		class="add add-item"
		action="/list/items"
		method="post"
		hx-post="/list/items"
		hx-target="#list"
		hx-swap="innerHTML"
		hx-on::after-request="if (event.detail.successful) { this.reset(); this.querySelector('input').focus() }"
	>
		<label class="visually-hidden" for="add-name">Item</label>
		<input id="add-name" name="name" required maxlength="100" placeholder="Add an item" autocomplete="off"/>
		<label class="visually-hidden" for="add-section">Section</label>
		<select id="add-section" name="section">
			for _, s := range sections {
				<option value={ s.Key } selected?={ s.Key == "other" }>{ s.Name }</option>
			}
		</select>
		<button type="submit" class="secondary-btn">Add</button>
	</form>
}
