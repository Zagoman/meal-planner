package web

import "github.com/Zagoman/meal-planner/internal/domain"

// RecipesPage lists saved recipes. Window 3 turns it into the library with
// search, filters and tweaks.
templ RecipesPage(recipes []domain.Recipe) {
	@Layout("Recipes", TabRecipes) {
		if len(recipes) == 0 {
			<div class="empty">
				<p>No saved recipes yet.</p>
				<p class="muted small">Rate a meal from this week to keep it here.</p>
			</div>
		} else {
			<div id="recipe-results" class="meals">
				for _, r := range recipes {
					<article class="meal card" id={ "recipe-" + r.ID.String() }>
						if r.SourceMealID != nil {
							<a class="meal-link" href={ templ.SafeURL("/meals/" + r.SourceMealID.String()) }>
								<span class="meal-text">
									<span class="meal-title">{ r.Meal.Title }</span>
									<span class="small muted">{ r.Meal.MealType.Label() } · { itoa(r.Meal.Minutes) } min</span>
								</span>
								<span class="meal-go">Recipe</span>
							</a>
						} else {
							<div class="meal-link">
								<span class="meal-text">
									<span class="meal-title">{ r.Meal.Title }</span>
									<span class="small muted">{ r.Meal.MealType.Label() } · { itoa(r.Meal.Minutes) } min</span>
								</span>
							</div>
						}
					</article>
				}
			</div>
		}
	}
}
