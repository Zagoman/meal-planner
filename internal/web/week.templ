package web

import (
	"github.com/google/uuid"

	"github.com/Zagoman/meal-planner/internal/domain"
)

// WeekPage is this week's confirmed plan with the draft card for next
// week on top. Both refresh over SSE (/events).
templ WeekPage(p domain.Plan, hasPlan bool, card domain.DraftCard) {
	@Layout("This week", TabWeek) {
		<div hx-ext="sse" sse-connect="/events">
			@DraftCard(card)
			@WeekBody(p, hasPlan)
		</div>
	}
}

templ WeekBody(p domain.Plan, hasPlan bool) {
	<div id="week" hx-get="/week" hx-select="#week" hx-trigger="sse:plan.updated" hx-swap="outerHTML">
		if !hasPlan {
			<p class="empty muted">No plan for this week yet.</p>
		} else {
			@ConfirmNote(p)
			<p class="muted small sub">{ mealCount(len(p.Meals)) } · cook them in any order</p>
			<h2 class="sec-label">This week's meals</h2>
			<div id="week-meals" class="meals">
				for _, m := range p.Meals {
					@MealCard(m)
				}
			</div>
			<p class="muted small">Days are only suggestions.</p>
		}
	</div>
}

templ MealCard(m domain.Meal) {
	<article class="meal card" id={ "meal-" + m.ID.String() }>
		<a class="meal-link" href={ templ.SafeURL("/meals/" + m.ID.String()) }>
			<span class="meal-text">
				<span class="meal-title">{ m.Title }</span>
				<span class="small muted">{ mealMeta(m) }</span>
			</span>
			<span class="meal-go">Recipe</span>
		</a>
	</article>
}

templ RateForm(mealID uuid.UUID) {
	<form
		class="rate-form"
		action={ templ.SafeURL("/meals/" + mealID.String() + "/rate") }
		method="post"
		hx-post={ "/meals/" + mealID.String() + "/rate" }
		hx-swap="outerHTML"
	>
		<fieldset class="stars">
			<legend>How was it?</legend>
			for i := 1; i <= 5; i++ {
				<label>
					<input type="radio" name="rating" value={ itoa(i) } required/>
					<span>{ itoa(i) }</span>
				</label>
			}
		</fieldset>
		<label class="visually-hidden" for={ "note-" + mealID.String() }>Note</label>
		<input id={ "note-" + mealID.String() } name="note" maxlength="500" placeholder="Note (optional), e.g. baby loved it"/>
		<button type="submit">Save rating</button>
	</form>
}

templ Rated(f domain.Feedback) {
	<p class="rated">
		Rated { itoa(f.Rating) }/5 ✓
		if f.Note != "" {
			<span class="muted">“{ f.Note }”</span>
		}
	</p>
}
