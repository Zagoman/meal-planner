package web

import (
	"strconv"
	"time"

	"github.com/google/uuid"

	"github.com/Zagoman/meal-planner/internal/domain"
)

// recipePic is what a recipe page needs to show its picture.
type recipePic struct {
	RecipeID *uuid.UUID // nil: drawing only, no photo upload
	Title    string
	Dish     domain.DishType
	PhotoAt  *time.Time
	Back     string // page to return to after an upload without JavaScript
}

// RecipePicture is the family's photo of a recipe, or the line drawing for
// its dish type, with "Add your photo" (design handover: has-photo).
templ RecipePicture(p recipePic) {
	<figure id="recipe-picture" class={ "recipe-pic", templ.KV("has-photo", p.PhotoAt != nil) }>
		if p.PhotoAt != nil && p.RecipeID != nil {
			<img class="hsv-drawing has-photo" src={ photoURL(*p.RecipeID, *p.PhotoAt) } alt={ "Your photo of " + p.Title } loading="lazy"/>
		} else {
			<div class="hsv-drawing">
				@Drawing(p.Dish)
			</div>
		}
		if p.RecipeID != nil {
			<form class="pic-actions" action={ templ.SafeURL("/recipes/" + p.RecipeID.String() + "/photo") } method="post" enctype="multipart/form-data" hx-boost="false">
				<input type="hidden" name="back" value={ p.Back }/>
				<label class="button secondary-btn file-label">
					if p.PhotoAt != nil {
						Change photo
					} else {
						Add your photo
					}
					<input type="file" name="photo" accept="image/*" required class="file-input" onchange="this.form.requestSubmit()"/>
				</label>
				<noscript><button type="submit" class="secondary-btn">Upload</button></noscript>
				if p.PhotoAt != nil {
					<button type="submit" class="link" formaction={ templ.SafeURL("/recipes/" + p.RecipeID.String() + "/photo/delete") } formnovalidate>Remove photo</button>
				}
			</form>
		}
	</figure>
}

func photoURL(id uuid.UUID, at time.Time) string {
	return "/recipes/" + id.String() + "/photo?v=" + strconv.FormatInt(at.Unix(), 10)
}

// Drawing is the line drawing for a dish type, drawn in the ink colour so it
// follows the theme. Decorative: the title says what the dish is.
templ Drawing(d domain.DishType) {
	<svg class="drawing" viewBox="0 0 120 90" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch d {
			case domain.DishSoup:
				<path d="M18 42h84c0 22-19 36-42 36S18 64 18 42z"></path>
				<path d="M46 70h28"></path>
				<path d="M48 32c0-5 5-5 5-11"></path>
				<path d="M60 32c0-5 5-5 5-11"></path>
				<path d="M72 32c0-5 5-5 5-11"></path>
			case domain.DishPasta:
				<circle cx="56" cy="46" r="34"></circle>
				<circle cx="56" cy="46" r="22"></circle>
				<path d="M42 40q4-6 8 0t8 0t8 0"></path>
				<path d="M42 50q4-6 8 0t8 0t8 0"></path>
				<path d="M106 14v62"></path>
				<path d="M101 14v12q0 5 5 5t5-5V14"></path>
			case domain.DishFish:
				<path d="M20 45q32-28 64 0q-32 28-64 0z"></path>
				<path d="M84 45l18-14v28z"></path>
				<circle cx="34" cy="42" r="2" fill="currentColor" stroke="none"></circle>
				<path d="M56 34q6 11 0 22"></path>
			case domain.DishCake:
				<path d="M22 72h76V46L22 30z"></path>
				<path d="M22 52h76"></path>
				<path d="M22 30l76 16"></path>
				<circle cx="74" cy="34" r="4"></circle>
				<path d="M74 30v-6"></path>
			case domain.DishOnePot:
				<path d="M28 40h64v28q0 8-8 8H36q-8 0-8-8z"></path>
				<path d="M22 40h76"></path>
				<path d="M28 50h-8"></path>
				<path d="M92 50h8"></path>
				<path d="M54 33h12"></path>
				<path d="M40 28c0-4 4-4 4-9"></path>
				<path d="M76 28c0-4 4-4 4-9"></path>
			default:
				<rect x="18" y="38" width="84" height="34" rx="4"></rect>
				<path d="M10 46h8"></path>
				<path d="M102 46h8"></path>
				<path d="M30 52l12 10"></path>
				<path d="M50 50l12 10"></path>
				<path d="M70 52l12 10"></path>
		}
	</svg>
}
